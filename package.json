  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -R src/styles dist/styles",
    "typecheck": "tsc --noEmit",
    "check:dist": "node scripts/check-dist.mjs",
    "check:css": "node scripts/check-css.mjs",
    "checks": "pnpm typecheck && pnpm test && pnpm build && pnpm check:dist && pnpm check:css && pnpm check:package",
    "changeset": "changeset",
    "release": "pnpm checks && changeset publish",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "check:package": "publint --strict && attw --pack --profile esm-only --exclude-entrypoints styles.css tokens.css"
  },
